# Ansible-managed Postfix configuration (satellite)

smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no

myhostname = {{ mail_postfix_hostname }}
myorigin = /etc/mailname
transport_maps = hash:/etc/postfix/transport

# Only accept mail for localhost users – no external domains
mydestination = localhost.localdomain, localhost
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128

# Relay all outgoing mail through this host (empty = no relay)
relayhost = {{ mail_postfix_relayhost | default('') }}

mailbox_size_limit = 0
recipient_delimiter = +
inet_interfaces = loopback-only
inet_protocols = all

smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination
